{
  "description": "launch.mjs: every command below runs through it; it verifies the plugin's files against integrity-manifest.json first, restores a damaged one from the marketplace clone, and reports what it cannot restore (DX-3997). event-hook.sh: for a plan-connected session, the registry's effective text for SessionStart (startup/resume/compaction) and for every sub-agent (any type, any plugin) at SubagentStart; silent when not connected (DX-3421). ensure-dashboard-mcp.sh: installs the pinned danx-dashboard-mcp into the plugin data dir once, so the fetch runs it with node, never a cold npx (DX-3811). plan-event-bridge.mjs: relays the connected plan's events into the session. bridge-watchdog.mjs: restarts a dead bridge (PostToolUse, Stop). background-work-report.mjs: reports running background work to quiet the idle nudge. activity-report.mjs: tells the dashboard when a sub-agent starts or finishes and when a background Bash call starts, so the session's running count closes (DX-3284). inject-time.sh: wall clock with UTC offset.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" --via stdout scripts/inject-time.sh UserPromptSubmit || echo \"[danxbot plugin] the hook launcher failed to run, so the plugin install may be corrupt and danxbot hooks may be dead. Fix: delete the plugin cache directory, run update-claude-plugins, restart the session.\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/background-work-report.mjs session-start",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/ensure-dashboard-mcp.sh --prewarm",
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" --via stdout scripts/event-hook.sh SessionStart || echo \"[danxbot plugin] the hook launcher failed to run, so the plugin install may be corrupt and danxbot hooks may be dead. Fix: delete the plugin cache directory, run update-claude-plugins, restart the session.\""
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" --via rewake scripts/plan-event-bridge.mjs start",
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/event-hook.sh SubagentStart"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/activity-report.mjs subagent-start",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/inject-time.sh PostToolUse"
          }
        ]
      },
      {
        "matcher": "^(mcp__danx_dashboard__plan_connect|mcp__danx-dashboard__plan_connect)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" --via rewake scripts/plan-event-bridge.mjs start",
            "async": true,
            "asyncRewake": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" --via rewake scripts/bridge-watchdog.mjs",
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/background-work-report.mjs heartbeat",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/activity-report.mjs background-bash",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" --via rewake scripts/bridge-watchdog.mjs",
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/background-work-report.mjs stop",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/background-work-report.mjs subagent-stop",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/activity-report.mjs subagent-stop",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/background-work-report.mjs stop-failure",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.mjs\" scripts/plan-event-bridge.mjs stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

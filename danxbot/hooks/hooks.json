{
  "description": "DX-3275 / PLN-11 R-10: before a plan is connected, SessionStart shows only mantra.sh's short plan-workflow nudge — plan-workflow-autoload.sh's full skill-body dump stays silent until the session's connection record exists. Once plan_connect succeeds, plan-connect-mantra.mjs surfaces the full mantra immediately (PostToolUse), and the next SessionStart brings in the full mantra + skill-body autoload. Also runs the plan event bridge (relays a connected Plan's dashboard events into the session inbox) plus its watchdog, a plan-link auto-connect hook (fires only when the prompt contains a plan URL), and captures the plan tab id on connect. DX-3367: background-work-report.mjs also reports a session's in-flight background-task count (Stop/SubagentStop/SessionStart/StopFailure/PostToolUse heartbeat) so the dashboard's idle-nudge is suppressed while a background sub-agent or shell is genuinely still working. Each script's own header comment documents its exact trigger and behavior. Also: inject-time.sh stamps the clock with its UTC offset on every prompt and tool call; compaction-skill-reload.sh (SessionStart compact) makes the agent reload truncated skills.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/inject-time.sh UserPromptSubmit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-link-connect.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/plan-workflow-autoload.sh SessionStart"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/background-work-report.mjs\" session-start",
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/mantra.sh SessionStart"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" start",
            "async": true,
            "asyncRewake": true
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/compaction-skill-reload.sh SessionStart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/inject-time.sh PostToolUse"
          }
        ]
      },
      {
        "matcher": "^(mcp__danx_dashboard__plan_connect|mcp__danx-dashboard__plan_connect)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" start",
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-tab-watch.mjs\" capture"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-connect-mantra.mjs\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" watchdog",
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/background-work-report.mjs\" heartbeat",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" watchdog",
            "async": true,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/background-work-report.mjs\" stop",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/background-work-report.mjs\" subagent-stop",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/background-work-report.mjs\" stop-failure",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-event-bridge.mjs\" stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
